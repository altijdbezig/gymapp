# Copy this file to .env and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API
#
# Only EXPO_PUBLIC_* variables are readable inside the app. That is fine for the
# publishable key (Row Level Security protects the data) but never put the
# service role key in here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
